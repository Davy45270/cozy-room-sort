{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cozy-room-sort.dav123.fr/level.schema.json",
  "title": "Niveau Cozy Room Sort",
  "description": "Contrat 1.1. validateLevel migre les anciens niveaux et vérifie aussi les quotas, les dépendances et le pourcentage d’objets masqués.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "rulesVersion",
    "id",
    "name",
    "theme",
    "difficulty",
    "seed",
    "rules",
    "categories",
    "boxes",
    "objects",
    "scoring"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1"
    },
    "rulesVersion": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "theme": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "enum": [
        "easy",
        "medium",
        "expert"
      ]
    },
    "seed": {
      "type": "integer"
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bufferCapacity",
        "activeBoxCount",
        "allowUndo",
        "allowHints",
        "timeLimitSeconds"
      ],
      "properties": {
        "bufferCapacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "activeBoxCount": {
          "type": "integer",
          "minimum": 1
        },
        "allowUndo": {
          "type": "boolean"
        },
        "allowHints": {
          "type": "boolean"
        },
        "timeLimitSeconds": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "undoLimit": {
          "type": "number",
          "minimum": 0
        },
        "hintLimit": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "boxes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "capacity"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string"
          },
          "capacity": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "asset",
          "position",
          "layer",
          "blockedBy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string"
          },
          "asset": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "layer": {
            "type": "integer"
          },
          "blockedBy": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hidden": {
            "type": "boolean"
          }
        }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threeStarsMaxBuffered",
        "twoStarsMaxBuffered"
      ],
      "description": "Étoiles comptées en passages par le tampon.",
      "properties": {
        "threeStarsMaxBuffered": {
          "type": "integer",
          "minimum": 0
        },
        "twoStarsMaxBuffered": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "solution": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "engineVersion": {
          "type": "string"
        },
        "statesExplored": {
          "type": "integer",
          "minimum": 0
        },
        "nonTrivialDecisions": {
          "type": "integer",
          "minimum": 0
        },
        "legalMoves": {
          "type": "integer",
          "minimum": 0
        },
        "blockingMoves": {
          "type": "integer",
          "minimum": 0
        },
        "blockingMoveShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "difficulty": {
            "const": "easy"
          }
        }
      },
      "then": {
        "properties": {
          "objects": {
            "minItems": 9,
            "maxItems": 15
          },
          "categories": {
            "minItems": 3,
            "maxItems": 3
          },
          "rules": {
            "properties": {
              "bufferCapacity": {
                "const": 5
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "difficulty": {
            "const": "medium"
          }
        }
      },
      "then": {
        "properties": {
          "objects": {
            "minItems": 16,
            "maxItems": 30
          },
          "categories": {
            "minItems": 4,
            "maxItems": 6
          },
          "rules": {
            "properties": {
              "bufferCapacity": {
                "const": 4
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "difficulty": {
            "const": "expert"
          }
        }
      },
      "then": {
        "properties": {
          "objects": {
            "minItems": 31,
            "maxItems": 60
          },
          "categories": {
            "minItems": 6,
            "maxItems": 10
          },
          "rules": {
            "properties": {
              "bufferCapacity": {
                "const": 3
              }
            }
          }
        }
      }
    }
  ]
}
