{
  "name": "cozy-room-sort",
  "version": "0.1.0",
  "private": true,
  "description": "Cozy Room Sort : ranger une pièce en triant ses objets dans des cartons. Jeu hors ligne pour toute la famille.",
  "license": "MIT",
  "author": "David Sevin",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --max-warnings=0",
    "test": "vitest run --pool=threads --maxWorkers=2",
    "level:validate": "node tools/validate-levels.ts",
    "level:solve": "node tools/solve-level.ts",
    "dev": "vite apps/web",
    "build": "tsc --noEmit && vite build apps/web",
    "preview": "vite preview apps/web",
    "check:precache": "node scripts/check-precache.js",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "fake-indexeddb": "6.2.8",
    "fast-check": "4.10.3",
    "happy-dom": "21.0.4",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  }
}
